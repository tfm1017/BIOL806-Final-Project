#create a list of pluripotency, differentiation, and housekeeping genes
pluripotency_genes <- c("SOX2", "POU5F1", "KLF4", 
                        "MYC","PODXL", "NANOG", 
                        "FUT4", "LIN28A", "ALPL")

differentiation_genes <- c("PAX6","NES","KRT14", 
                           "SOX17", "AFP", "PDX1", 
                           "CD34", "THY1", "NKX2-5")

